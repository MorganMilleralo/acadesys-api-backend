# Copiar como .env y completar. Solo valores de ejemplo: nunca subir credenciales reales.

# Servidor
PORT=3000
NODE_ENV=development
API_PUBLIC_URL=http://localhost:3000
FRONTEND_PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Base de datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=acadesys
DB_PASSWORD=cambiar
DB_NAME=acadesys

# Autenticación (mínimo 32 caracteres)
JWT_SECRET=cambiar_por_un_secreto_aleatorio_de_32_caracteres_o_mas

# Matrícula pública y correos (Google Apps Script)
PUBLIC_REGISTRATION_ACADEMY_ID=1
GOOGLE_SCRIPT_URL=
GOOGLE_SCRIPT_TOKEN=

# Archivos locales heredados (los nuevos PDF y fotos se guardan en MySQL)
UPLOADS_DIR=./uploads

# Pago online: Mercado Pago Checkout Pro (Orders API), solo modo TEST.
# Si falta o es inválida cualquiera de estas variables, /checkout y /conciliar
# responden 503 con el código del problema (por ejemplo CONFIG_PAGOS_INVALIDA).
PAYMENT_PROVIDER=MERCADOPAGO
PAYMENT_ENVIRONMENT=TEST
PAYMENT_CURRENCY=PEN
PAYMENT_REFERENCE_PREFIX=ACS
PAYMENT_CHECKOUT_RESERVATION_TIMEOUT_SECONDS=120
PAYMENT_RECONCILIATION_INTERVAL_MS=30000
MERCADOPAGO_API_BASE_URL=https://api.mercadopago.com
# Access Token de la cuenta de prueba (empieza con APP_USR-)
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta del webhook (panel de Mercado Pago > Webhooks), mínimo 16 caracteres.
# URL del webhook: https://<API_PUBLIC_URL>/api/webhooks/mercadopago
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_ITEM_TITLE_PREFIX=AcadeSys
MERCADOPAGO_CHECKOUT_ALLOWED_HOSTS=www.mercadopago.com.pe,sandbox.mercadopago.com.pe
MERCADOPAGO_REQUEST_TIMEOUT_MS=10000
MERCADOPAGO_WEBHOOK_TOLERANCE_SECONDS=300
FRONTEND_PUBLIC_URL=https://acadesys-web-frontend.vercel.app
MERCADOPAGO_SUCCESS_RETURN_PATH=/?payment_status=success
MERCADOPAGO_FAILURE_RETURN_PATH=/?payment_status=failure
MERCADOPAGO_PENDING_RETURN_PATH=/?payment_status=pending

# Boleta electrónica SUNAT (servicio fact_api desplegado aparte).
# Si FACT_API_URL está vacío, los pagos funcionan igual y no se emite boleta.
FACT_API_URL=
FACT_API_EMAIL=
FACT_API_PASSWORD=
FACT_API_COMPANY_ID=1
FACT_API_BRANCH_ID=1
FACT_API_SERIE_BOLETA=B001
# 10 = gravado con IGV 18 %, 20 = exonerado (servicios educativos exonerados)
FACT_API_AFECTACION_IGV=10
FACT_API_TIMEOUT_MS=20000

# Datos para transferencias manuales
PAYMENT_ACADEMY_ID=1
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_HOLDER=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_CCI=
PAYMENT_INSTRUCTIONS=

# Generación automática de cuotas (scripts/generar-mensualidades-cron.js)
PAGOS_DIA_VENCIMIENTO=5
PAGOS_CRON_DRY_RUN=true

# Tutor IA (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=45000
