# Culqi - usar llaves pública y privada de la MISMA cuenta y entorno.
# La llave privada solo va en el entorno backend de Render.
PAYMENT_PROVIDER=CULQI
CULQI_PUBLIC_KEY=pk_test_REEMPLAZAR
CULQI_SECRET_KEY=sk_test_REEMPLAZAR

# Basic Auth del webhook (username de 4-20 chars, password de 12-120 chars).
CULQI_WEBHOOK_USERNAME=acadesysqa
CULQI_WEBHOOK_PASSWORD=REEMPLAZAR_POR_UNA_CLAVE_ALEATORIA_LARGA

CULQI_ORDER_EXPIRATION_MINUTES=30

# Render Cron: definir el día aprobado por la academia.
PAGOS_DIA_VENCIMIENTO=5
PAGOS_CRON_DRY_RUN=true
